# ==============================================================================
# DisasterShield — Environment Configuration Template (.env.example)
# Note: Real secrets should NEVER be committed to version control.
# Copy this file to .env for local overrides if using hosted LLM/embedding APIs.
# By default, DisasterShield runs 100% locally with zero paid API keys needed.
# ==============================================================================

# Application Server
PORT=5000
FLASK_ENV=development
SECRET_KEY=disastershield_local_dev_secret_key_change_in_prod

# RAG Pipeline Configuration
# Providers: 'local' (deterministic local TF-IDF + FAISS), 'openai', or 'gemini'
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_DIM=1024

# Generation Provider: 'local' (deterministic grounded synthesis), 'openai', or 'gemini'
RAG_GENERATOR_PROVIDER=local

# Document Chunking Parameters
# ~800 tokens = ~3200 characters; ~120 tokens overlap = ~480 characters
RAG_CHUNK_SIZE_CHARS=3200
RAG_CHUNK_OVERLAP_CHARS=480
RAG_MIN_CHUNK_CHARS=100

# Retrieval Parameters
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.10
# Hybrid Alpha: 0.60 dense FAISS cosine similarity + 0.40 sparse keyword match
RAG_HYBRID_ALPHA=0.60

# Document Upload Ingestion Constraints
RAG_MAX_UPLOAD_SIZE_MB=15

# Hosted LLM API Credentials (Optional - only needed if RAG_GENERATOR_PROVIDER is set to hosted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
